default_platform(:ios)

platform :ios do
  desc "Build DadStrong and upload to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: ENV["ASC_KEY_P8_BASE64"] == "1",
      duration: 1200,
      in_house: false
    )

    # Sync signing via match OR use automatic with API key + xcode
    if ENV["MATCH_GIT_URL"] && !ENV["MATCH_GIT_URL"].empty?
      match(
        type: "appstore",
        app_identifier: ["com.spiermen.dadstrong", "com.spiermen.dadstrong.widget"],
        readonly: is_ci,
        api_key: api_key
      )
    else
      UI.important("MATCH_GIT_URL not set — using automatic code signing (requires ASC API key + cloud certs).")
      update_code_signing_settings(
        use_automatic_signing: true,
        path: "ios/App/App.xcodeproj",
        team_id: ENV["ASC_TEAM_ID"]
      )
    end

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "DadStrong.ipa",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: ENV["TF_CHANGELOG"] || "DadStrong TestFlight build"
    )
  end

  desc "Verify Fastlane can talk to App Store Connect (no build)"
  lane :ping do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: ENV["ASC_KEY_P8_BASE64"] == "1"
    )
    UI.success("API key loaded for issuer #{ENV['ASC_ISSUER_ID']}")
  end
end
